# ===== Konfigurimi i Finbot =====
# Kopjo këtë skedar në ".env" dhe plotëso vlerat para prodhimit.

PORT=3000
NODE_ENV=production

# Sekretet — TË DETYRUESHME në prodhim. Gjenero vlera të gjata të rastësishme:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
CRED_KEY=

# Vendndodhja e bazës SQLite (në Docker vendoset në volumen /data)
DB_PATH=/data/finbot.db

# Robotët realë: 1 = aktiv (hap browser për çdo ekzekutim), 0 = simulim
ROBOTS_REAL=0

# URL-ja e portalit për robotin shembull (ndryshoje me portalin real)
# MOCK_PORTAL_URL=http://localhost:3000/mock-portal.html

# Llogaritë fillestare (përdoren vetëm në mbjelljen e parë)
OWNER_EMAIL=owner@finbot.al
OWNER_PASS=
ADMIN_EMAIL=admin@finbot.al
ADMIN_PASS=
