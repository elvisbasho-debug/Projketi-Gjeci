# ===== Konfigurimi i Finbot =====
# Kopjo këtë skedar në ".env" dhe plotëso vlerat para prodhimit.

PORT=3000
NODE_ENV=production

# Sekretet: TË DETYRUESHME në prodhim. Gjenero vlera të gjata të rastësishme:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# CRED_KEY enkripton fjalëkalimet e bizneseve: mos e ndrysho pasi të kesh të dhëna.
JWT_SECRET=
CRED_KEY=

# Vendndodhja e bazës SQLite (në Docker/Render: diski /data)
DB_PATH=/data/finbot.db

# Llogaria e pronarit të platformës (vetëm në nisjen e parë). OWNER_PASS i detyrueshëm në prodhim.
OWNER_EMAIL=owner@finbot.al
OWNER_PASS=
# Opsionale: admin i dytë i platformës (bosh = nuk krijohet)
ADMIN_EMAIL=admin@finbot.al
ADMIN_PASS=

# Pyet VA me Claude (opsionale; pa të përdoren rregullat lokale)
ANTHROPIC_API_KEY=
# VA_MODEL=claude-opus-5-5

# Robotët realë: bosh = simulim; "1" = të gjithë; ose listë: tvsh_deklarim
ROBOTS_REAL=
# Konektori i C@ts (shih docs/KONEKTORI-TVSH.md)
# CATS_BASE_URL=https://efiling.tatime.gov.al
CATS_MONTHLY_PATH=
CATS_LEDGER_PATH=
# ROBOTS_ALLOW_DECLARE=1   # VETËM me autorizim: lejon dorëzimin real të deklaratave

# Kufijtë e robotëve
# ROBOTS_CONCURRENCY=6
# ROBOTS_PER_ORG=12
# ROBOTS_PER_USER=3

# Faturimi i studiove
# INVOICE_DUE_DAYS=15
# INVOICE_VAT_RATE=0.2
# BILLING_AUTO=1
